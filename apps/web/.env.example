# Copy to .env.local (or set in the shell) and adjust.
#
#   cp .env.example .env.local

# Base URL of the NestJS API. The client appends /api/v1 automatically.
# In development you can omit this: next.config.ts rewrites /api/* to
# http://localhost:4000 and the client defaults to the same origin, so no
# CORS is involved. Set it explicitly when the API lives elsewhere
# (e.g. https://api.example.com).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional: where the API runs in dev (used by the /api/* rewrite).
# API_TARGET=http://localhost:4000
