{
  "name": "@institutes/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS modular-monolith backend for the institutes marketplace",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "echo \"No API test suite yet. See apps/mobile for Flutter tests.\" && exit 0",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "db:generate": "echo \"no codegen required (Kysely types are hand-written in src/db/schema.ts)\"",
    "db:migrate": "ts-node --transpile-only src/db/migrate.ts up",
    "db:reset": "ts-node --transpile-only src/db/migrate.ts reset",
    "db:seed": "echo \"Seed script not implemented yet (src/db/seed.ts).\" && exit 1",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node --transpile-only src/worker.ts",
    "db:migrate:down": "ts-node --transpile-only src/db/migrate.ts down",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.28",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "kysely": "^0.29.4",
    "nanoid": "3.3.11",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "slugify": "1.6.9",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.28",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  }
}
