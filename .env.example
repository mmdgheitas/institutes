# Copy to .env and adjust. Every value below matches docker-compose.yml, so
# with the containers running the defaults work as-is.
#
#   cp .env.example .env
#   docker compose up -d
#   npm run db:migrate && npm run db:seed

# ----------------------------------------------------------------- runtime --
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------- database --
# Requires the PostGIS extension.
DATABASE_URL=postgresql://institutes:institutes@localhost:5433/institutes
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ------------------------------------------------------------------- redis --
REDIS_URL=redis://localhost:6379
# Set false to run without Redis; background jobs become no-ops.
REDIS_ENABLED=true

# --------------------------------------------------------------------- jwt --
# CHANGE BOTH before deploying anywhere real.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --------------------------------------------------------------------- otp --
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=5
# Accepted in place of any real code outside production. Unset to disable.
OTP_DEV_CODE=11111

# ---------------------------------------------------------------- storage ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=institutes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/institutes
S3_PRESIGN_EXPIRY=900
# 2 GiB — the hard ceiling for any single presigned upload.
S3_MAX_UPLOAD_BYTES=2147483648

# -------------------------------------------------------------------- sms ---
# console = log messages instead of sending them (no credentials needed).
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=10004346

# ------------------------------------------------------------ live classes --
BBB_BASE_URL=https://bbb.example.com/bigbluebutton/api
BBB_SECRET=dev-bbb-secret
ADOBE_CONNECT_URL=https://connect.example.com/api/xml
ADOBE_CONNECT_KEY=dev-adobe-key
ADOBE_SESSION_TTL=3600

# ---------------------------------------------------------------- platform --
PLATFORM_COMMISSION_PERCENT=10
PLATFORM_CURRENCY=IRR
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# -------------------------------------------------------------------- seed --
# Password given to every seeded account.
SEED_PASSWORD=Password123
